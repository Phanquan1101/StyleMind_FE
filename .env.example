# Browser calls the API Gateway. Leave this empty in local development so Vite proxies the API paths.
VITE_API_BASE_URL=
# API Gateway address used only by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
# Chọn api để dùng Friends, Outfit Sharing và Chat qua Gateway.
VITE_COMMUNITY_MODE=api
# LocationIQ access token cho gợi ý địa chỉ; điền trong file .env, không commit key.
VITE_LOCATIONIQ_TOKEN=
